// ============================================================
// SkillGraph AI — Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(100)
  email          String   @unique @db.VarChar(255)
  password       String   @db.VarChar(255)
  role           Role     @default(USER)

  // Career profile
  targetRole     String?  @default("Full-Stack Developer") @map("target_role") @db.VarChar(100)

  // Resume data
  resumeText     String?  @map("resume_text") @db.Text
  resumeParsed   Json?    @map("resume_parsed")
  resumeAnalysis Json?    @map("resume_analysis")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  interviewSessions InterviewSession[]

  @@index([email])
  @@map("users")
}

model InterviewSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   @map("type") @db.VarChar(50) // HR, TECHNICAL, BEHAVIOURAL
  createdAt DateTime @default(now()) @map("created_at")

  questions InterviewQuestion[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("interview_sessions")
}

model InterviewQuestion {
  id                    String   @id @default(uuid())
  sessionId             String   @map("session_id")
  questionText          String   @map("question_text") @db.Text
  userAnswer            String?  @map("user_answer") @db.Text
  feedback              String?  @map("feedback") @db.Text
  suggestedImprovements String?  @map("suggested_improvements") @db.Text
  modelAnswer           String?  @map("model_answer") @db.Text
  score                 Int?     @map("score")
  createdAt             DateTime @default(now()) @map("created_at")

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("interview_questions")
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blacklisted_tokens")
}
