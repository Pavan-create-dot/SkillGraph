# ============================================================
# SkillGraph AI – Root Environment Variables
# ============================================================

# See backend/.env.example for backend configuration
# Copy backend/.env.example to backend/.env before running

# ─── Docker Compose Overrides ────────────────────────────────
COMPOSE_PROJECT_NAME=skillgraph

# Frontend
VITE_API_URL=http://localhost:5000/api/v1

# Google Sign-In Client ID (must match GOOGLE_CLIENT_ID in backend/.env)
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
